<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Transport info between steps -->
    <TextView
        android:id="@+id/tvTransportInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚶 15 min de marche (1.2 km)"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="#F5F5F5"
        android:gravity="center"
        android:visibility="gone"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Timeline indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#D81B60"/>

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="#D81B60"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#D81B60"/>
            </LinearLayout>

            <!-- Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTimeSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 - 11:00 (Matin)"
                    android:textColor="#D81B60"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Musée du Louvre"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visite guidée des galeries principales."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp"
                    android:maxLines="3"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvStepDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 20€ • 🏛️ Culture"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Image placeholder -->
            <ImageView
                android:id="@+id/ivStepImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
