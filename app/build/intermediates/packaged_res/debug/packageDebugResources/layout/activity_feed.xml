<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- AppBar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#7C4DFF"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="Retour"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fil d'actualité"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="8dp" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#FFFFFF"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:contentDescription="Rechercher"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <Button
            android:id="@+id/btnLoginFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connexion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#6C63FF"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="18dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#FFFFFF"
            app:cardBackgroundColor="#2A2A3E"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFeedProfileInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="V"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.appcompat.widget.Toolbar>

    <!-- Search Bar (hidden by default) -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Rechercher par lieu, auteur ou tag..."
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:visibility="gone"/>

    <!-- Bannière Mode Découverte (visible si anonyme) -->
    <LinearLayout
        android:id="@+id/bannerAnonymous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A1A4E"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Mode Découverte"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inscrivez-vous pour publier, liker, commenter et créer des groupes de voyage."
            android:textColor="#CCCCDD"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSignupBanner"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="S'inscrire"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLoginBanner"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Se connecter"
                android:textColor="#6C63FF"
                app:strokeColor="#6C63FF"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView du flux principal -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotoFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="88dp" />

        <!-- FAB Publier (visible si connecté) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPublish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            app:srcCompat="@android:drawable/ic_input_add"
            app:tint="#FFFFFF"
            android:backgroundTint="#D81B60"
            app:elevation="8dp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
