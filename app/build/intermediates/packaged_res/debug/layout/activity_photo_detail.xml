<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/white"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert" />
        </androidx.appcompat.widget.Toolbar>

        <!-- Photo -->
        <ImageView
            android:id="@+id/ivDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:background="#CCCCCC" />

        <!-- Infos Auteur + Abonnement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDetailAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sophie Martin"
                android:textStyle="bold"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSubscribeAuthor"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="S'abonner"
                android:backgroundTint="#6C63FF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Lieu + Description -->
        <TextView
            android:id="@+id/tvDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tour Eiffel, Paris"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description de la photo..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnLikeDetail"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/btn_star_big_off" />

            <TextView
                android:id="@+id/tvDetailLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="245 J'aime"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnCommentDetail"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="16dp"
                android:src="@android:drawable/ic_menu_edit" />

            <TextView
                android:id="@+id/tvDetailComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="18 commentaires"
                android:textSize="14sp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnReportDetail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_report_image" />
        </LinearLayout>

        <!-- Bouton GPS -->
        <Button
            android:id="@+id/btnNavigate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="📍 Comment y aller (GPS)"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>
</ScrollView>
