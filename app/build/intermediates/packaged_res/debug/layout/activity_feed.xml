<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- AppBar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TravelShare"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="12dp" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnLoginFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connexion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:visibility="gone" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Bannière Mode Découverte (visible si anonyme) -->
    <LinearLayout
        android:id="@+id/bannerAnonymous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEF0FF"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode découverte - Connectez-vous pour publier, commenter et créer des groupes"
            android:textColor="#6C63FF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSignupBanner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="S'inscrire"
                android:backgroundTint="#6C63FF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLoginBanner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Se connecter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView du flux principal -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPhotoFeed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- FAB Publier (visible si connecté) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPublish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@android:drawable/ic_input_add"
        android:backgroundTint="#6C63FF"
        android:visibility="gone" />

</LinearLayout>
